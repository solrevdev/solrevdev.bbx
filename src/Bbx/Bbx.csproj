<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- System.CommandLine 2.0 derives the name in usage/help from the
         assembly and no longer lets RootCommand.Name be set, so the assembly
         is named for the command it provides. -->
    <AssemblyName>bbx</AssemblyName>
    <RootNamespace>Bbx</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Run on a newer major runtime than the asset was built for, so the tool
         still works on a machine that has only the latest .NET installed. -->
    <RollForward>Major</RollForward>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bbx</ToolCommandName>
    <PackageId>solrevdev.bbx</PackageId>

    <!-- First public release. CI bumps this; a plain push to master bumps the
         patch, larger bumps go through workflow_dispatch. -->
    <Version>1.3.0</Version>

    <!-- NuGet metadata -->
    <Authors>solrevdev</Authors>
    <Company>solrevdev</Company>
    <Product>bbx</Product>
    <Copyright>Copyright (c) solrevdev</Copyright>
    <Title>bbx — Bitbucket Cloud CLI</Title>
    <PackageDescription>gh for Bitbucket Cloud. A .NET global tool for the Bitbucket Cloud API v2: repositories, pull requests, branches, tags, commits, source files, downloads, pipelines, snippets, workspaces and projects. JSON on stdout and meaningful exit codes, so scripts and LLM agents can consume it.</PackageDescription>
    <PackageTags>bitbucket;cli;dotnet-tool;git;devops;llm;ai;api;pull-requests;pipelines;bitbucket-api;ci-cd</PackageTags>
    <RepositoryUrl>https://github.com/solrevdev/solrevdev.bbx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/solrevdev/solrevdev.bbx</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/solrevdev/solrevdev.bbx/blob/master/CHANGELOG.md</PackageReleaseNotes>

    <!-- Ship symbols so stack traces from a published build are readable. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- where pack puts .nupkg -->
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <!-- Reproducible builds on CI only: setting this locally breaks debugging. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- JsonElement.TryGetObject is used by nearly every handler -->
    <Using Include="Bbx.Api" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bbx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet.org strips raw HTML, so the package gets its own readme rather
         than the GitHub one with its collapsible sections. -->
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="../../docs/assets/branding/bbx-icon-128.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>
</Project>
